{
  "name": "codocs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky",
    "check:staged": "lint-staged",
    "typecheck": "node tools/build/build.mjs typecheck",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "test": "node tools/check/run.mjs test",
    "check:development": "node tools/check/run.mjs development",
    "build": "node tools/build/build.mjs build",
    "bundle": "node tools/build/build.mjs bundle",
    "check:build": "node tools/check/run.mjs build",
    "test:run": "node tools/check/run.mjs test:run",
    "test:ui": "node tools/ui-tests/run.mjs",
    "performance:cod14": "node tools/performance/runner.mjs",
    "check": "node tools/check/run.mjs all",
    "test:environment": "node tools/environment-tests/run.mjs",
    "test:tools": "node tools/check/run.mjs test:tools",
    "test:vscode": "node tools/vscode-tests/run.mjs",
    "check:commit": "node tools/check/pre-commit.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html,svg}": "prettier --write"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.3",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-jsdoc": "64.3.10",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "pnpm": "10.34.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
