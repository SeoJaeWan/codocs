{
  "name": "codocs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky",
    "build": "node tools/build/build.mjs build",
    "bundle": "node tools/build/build.mjs bundle",
    "typecheck": "node tools/build/build.mjs typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "test": "node tools/test/run.mjs",
    "test:vscode": "node packages/vscode/test-runner/run.mjs",
    "check": "pnpm check:static && pnpm check:runtime",
    "bench": "node tools/performance/runner.mjs",
    "release:pack": "node tools/build/release.mjs",
    "release:verify": "node tools/build/verify-release.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "check:static": "pnpm typecheck && pnpm lint && pnpm exec prettier . --check",
    "check:runtime": "pnpm build && pnpm test && pnpm exec vitest run --config vitest.checks.config.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html,svg}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.19.3",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-jsdoc": "64.3.10",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "pnpm": "10.34.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeoJaeWan/codocs.git"
  }
}
