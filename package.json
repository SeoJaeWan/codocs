{
  "name": "codosc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "node tools/build/build.mjs typecheck",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "test": "vitest",
    "check:development": "vitest run tools/developmentChecks",
    "build": "node tools/build/build.mjs build",
