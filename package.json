    "check:build": "vitest run tools/buildChecks"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-jsdoc": "64.3.10",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
