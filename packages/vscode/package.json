{
  "name": "codocs",
  "displayName": "Codocs",
  "description": "Connect code in a workspace to its local .codocs knowledge files.",
  "version": "0.0.5",
  "private": true,
  "publisher": "seojaewan",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codocs.restartLanguageServers"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codocs.restartLanguageServers",
        "title": "Codocs: Restart Language Servers"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeoJaeWan/codocs.git"
  },
  "icon": "logo.png"
}
