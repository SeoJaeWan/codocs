import { spawn } from 'node:child_process';
import { mkdir, mkdtemp, readFile, writeFile } from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import assert from 'node:assert/strict';
import { setTimeout as delay } from 'node:timers/promises';

const root = path.resolve(import.meta.dirname);
const version = process.argv[2] || '1.100.0';
const cache = process.env.COD29_VSCODE_CACHE || '/Users/seojaewan/Desktop/dev/codocs/.workbench/vscode-cache';
const application = path.join(cache, `darwin-arm64-${version}`, `vscode-darwin-arm64-${version}`, 'Visual Studio Code.app/Contents');
const executable = path.join(application, 'MacOS', version === '1.100.0' ? 'Electron' : 'Code');
const output = path.join(root, `results-${version}-${Date.now()}`);
const profile = await mkdtemp(path.join(os.tmpdir(), 'cod29-vsc-'));
await mkdir(path.join(profile, 'User'), {recursive: true});
await writeFile(path.join(profile, 'User/settings.json'), JSON.stringify({
  'files.autoSave': 'off', 'telemetry.telemetryLevel': 'off', 'update.mode': 'none',
  'extensions.autoUpdate': false, 'security.workspace.trust.enabled': false,
  'workbench.startupEditor': 'none', 'window.restoreWindows': 'none',
  'editor.inlayHints.enabled': 'on', 'editor.hover.delay': 200,
  'editor.hover.sticky': true, 'editor.fontSize': 16, 'editor.inlayHints.fontSize': 14,
  'workbench.colorTheme': 'Default Dark Modern', 'workbench.tips.enabled': false,
  'git.openRepositoryInParentFolders': 'never',
}));
const result = {version, profile, passed: false, checks: [], screenshots: []};
const child = spawn(executable, [
  path.join(root, 'workspace'), '--new-window', '--disable-extensions',
  `--extensionDevelopmentPath=${path.join(root, 'extension')}`,
  `--user-data-dir=${profile}`, `--extensions-dir=${path.join(output, 'extensions')}`,
  '--remote-debugging-port=0', '--skip-welcome', '--skip-release-notes', '--locale=en',
], {env: {...process.env, COD29_PROTOTYPE_OUTPUT: output}, stdio: ['ignore', 'pipe', 'pipe']});
let processLog = '';
child.stdout.on('data', data => {processLog += data;});
child.stderr.on('data', data => {processLog += data;});
let socket;
let nextId = 0;
const pending = new Map();
async function until(probe, label, timeout = 30000) {
  const began = Date.now();
  while (Date.now() - began < timeout) {
    if (child.exitCode !== null) throw new Error(`VS Code exited (${child.exitCode}): ${processLog}`);
    const value = await probe();
    if (value) return value;
    await delay(100);
  }
  throw new Error(`Timeout: ${label}`);
}
async function state() {
  try { return JSON.parse(await readFile(path.join(output, 'state.json'), 'utf8')); }
  catch (error) {if (error.code === 'ENOENT' || error instanceof SyntaxError) return null; throw error;}
}
function command(method, params = {}) {
  const id = ++nextId;
  return new Promise((resolve, reject) => {
    pending.set(id, {resolve, reject});
    socket.send(JSON.stringify({id, method, params}));
  });
}
async function evaluate(expression) {
  const value = await command('Runtime.evaluate', {expression, returnByValue: true, awaitPromise: true});
  if (value.exceptionDetails) throw new Error(JSON.stringify(value.exceptionDetails));
  return value.result.value;
}
async function screenshot(name) {
  const value = await command('Page.captureScreenshot', {format: 'png'});
  const filename = `${name}.png`;
  await writeFile(path.join(output, filename), Buffer.from(value.data, 'base64'));
  result.screenshots.push(filename);
}
async function textPoint(text, hoverOnly = false) {
  return evaluate(`(() => {
    const roots = ${hoverOnly ? "[...document.querySelectorAll('.monaco-hover')]" : "[...document.querySelectorAll('.monaco-editor')]"};
    for (const root of roots) {
      if (!root.getClientRects().length) continue;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      let node;
      while ((node = walker.nextNode())) {
        const start = node.textContent.replace(/\u00a0/g, ' ').indexOf(${JSON.stringify(text)});
        if (start < 0) continue;
        const range = document.createRange();
        range.setStart(node, start); range.setEnd(node, start + ${text.length});
        const rect = range.getBoundingClientRect();
        if (rect.width && rect.height) return {x: rect.x + rect.width / 2, y: rect.y + rect.height / 2, text: node.textContent, parentClass: node.parentElement.className};
      }
    }
    return null;
  })()`);
}
async function mouse(point, type = 'mouseMoved', modifiers = 0) {
  await command('Input.dispatchMouseEvent', {type, x: point.x, y: point.y, modifiers,
    ...(type === 'mouseMoved' ? {} : {button: 'left', clickCount: 1})});
}
async function click(point, modifiers = 0) {
  await mouse(point, 'mouseMoved', modifiers);
  await mouse(point, 'mousePressed', modifiers);
  await mouse(point, 'mouseReleased', modifiers);
}
async function dismiss() {
  await mouse({x: 30, y: 30});
  await command('Input.dispatchKeyEvent', {type: 'keyDown', key: 'Escape', code: 'Escape', windowsVirtualKeyCode: 27});
  await command('Input.dispatchKeyEvent', {type: 'keyUp', key: 'Escape', code: 'Escape', windowsVirtualKeyCode: 27});
  await delay(250);
}
let controlGeneration = 0;
async function setCount(count, inlayHintsEnabled = 'on') {
  const generation = ++controlGeneration;
  await writeFile(path.join(output, 'control.json'), JSON.stringify({count, inlayHintsEnabled, showDocument: true, generation}));
  await until(async () => {
    const value = await state();
    return value?.generation >= generation && value.activePath === '.codocs/a.yaml' && value.count === count;
  }, `set count ${count}`);
  await dismiss();
}
function check(name, evidence) {
  result.checks.push({name, passed: true, evidence});
  console.log(`PASS ${version}: ${name}`);
}
try {
  const ready = await until(async () => (await state())?.ready, 'extension activation', 60000);
  assert(ready);
  const port = await until(async () => {
    try { return (await readFile(path.join(profile, 'DevToolsActivePort'), 'utf8')).split('\n')[0]; }
    catch (error) {if(error.code === 'ENOENT') return null; throw error;}
  }, 'debug port');
  const target = await until(async () => {
    const targets = await (await fetch(`http://127.0.0.1:${port}/json/list`)).json();
    return targets.find(item => item.type === 'page' && /workbench/.test(item.url));
  }, 'workbench renderer');
  socket = new WebSocket(target.webSocketDebuggerUrl);
  await new Promise((resolve, reject) => {socket.addEventListener('open', resolve, {once: true}); socket.addEventListener('error', reject, {once: true});});
  socket.addEventListener('message', event => {
    const value = JSON.parse(event.data);
    if (!value.id) return;
    const waiting = pending.get(value.id); pending.delete(value.id);
    if (waiting) value.error ? waiting.reject(new Error(JSON.stringify(value.error))) : waiting.resolve(value.result);
  });
  await command('Runtime.enable'); await command('Page.bringToFront');
  const label2 = '문서 전체에 연결된 코드 · 2곳';
  const point2 = await until(() => textPoint(label2), 'two-reference label');
  check('virtual header rendered at first YAML line', point2);
  await screenshot('two-reference-header');
  await mouse(point2);
  const firstLink = await until(() => textPoint('src/parser.ts:2', true), 'first hover link');
  const secondLink = await until(() => textPoint('tests/parser.test.ts:2', true), 'second hover link');
  check('hover contains two separate links', {firstLink, secondLink});
  await delay(350);
  await screenshot('two-reference-hover');
  const beforeCountClick = (await state()).opens.length;
  await dismiss(); await click(point2); await delay(400);
  assert.equal((await state()).opens.length, beforeCountClick);
  await click(point2, 4); await delay(400);
  assert.equal((await state()).opens.length, beforeCountClick);
  assert.equal(await evaluate("!![...document.querySelectorAll('.quick-input-widget')].find(e => e.getClientRects().length && getComputedStyle(e).display !== 'none')"), false);
  check('multi-reference header click does not navigate or open picker', {activePath: (await state()).activePath});
  await mouse(point2);
  const selectedLink = await until(() => textPoint('tests/parser.test.ts:2', true), 'select test hover link');
  await click(selectedLink);
  const secondOpen = await until(async () => {
    const value = await state(); return value?.opens.at(-1)?.index === 1 ? value : null;
  }, 'test source navigation');
  assert.equal(secondOpen.activePath, 'tests/parser.test.ts');
  assert.equal(secondOpen.selection.start.line, 1);
  assert.equal(secondOpen.selection.start.character, 3);
  assert.equal(secondOpen.selection.end.character, 16);
  check('second hover link opens exact test occurrence', secondOpen.opens.at(-1));
  await screenshot('test-reference-open');
  await setCount(2);
  const repeatPoint = await until(() => textPoint(label2), 'header again');
  await mouse(repeatPoint);
  const sourceLink = await until(() => textPoint('src/parser.ts:2', true), 'select source hover link');
  await click(sourceLink);
  const firstOpen = await until(async () => {
    const value = await state(); return value?.opens.at(-1)?.index === 0 ? value : null;
  }, 'source navigation');
  assert.equal(firstOpen.activePath, 'src/parser.ts');
  assert.equal(firstOpen.selection.start.line, 1);
  assert.equal(firstOpen.selection.start.character, 5);
  assert.equal(firstOpen.selection.end.character, 18);
  assert(firstOpen.sourceBufferPreserved && firstOpen.sourceDirty);
  check('first hover link reuses dirty source and exact occurrence', firstOpen.opens.at(-1));
  await setCount(1);
  const point1 = await until(() => textPoint('문서 전체에 연결된 코드 · 1곳'), 'single label');
  await screenshot('single-reference-header');
  const beforeSingle = (await state()).opens.length;
  await click(point1); await delay(400);
  const plain = (await state()).opens.length > beforeSingle;
  result.singleReferenceGesture = {plainClick: plain, modifier: null};
  if (!plain) {
    await click(point1, 4);
    result.singleReferenceGesture.modifier = 'Command-click';
  }
  const singleOpen = await until(async () => {
    const value = await state(); return value?.opens.length > beforeSingle ? value : null;
  }, 'single direct navigation');
  assert.equal(singleOpen.activePath, 'src/parser.ts');
  assert.equal(singleOpen.selection.start.line, 1);
  assert.equal(singleOpen.selection.start.character, 5);
  assert.equal(singleOpen.selection.end.character, 18);
  check('2-to-1 refresh provides single direct navigation', result.singleReferenceGesture);
  await setCount(1, 'off'); await delay(500);
  assert.equal(await textPoint('문서 전체에 연결된 코드'), null);
  await setCount(1, 'on');
  await until(() => textPoint('문서 전체에 연결된 코드 · 1곳'), 'header restored after enabling hints');
  check('indicator follows editor.inlayHints.enabled setting', {off: 'hidden', on: 'visible'});
  await setCount(0); await delay(500);
  assert.equal(await textPoint('문서 전체에 연결된 코드'), null);
  check('1-to-0 refresh removes header', {count: 0});
  await screenshot('zero-reference-header');
  const final = await state();
  assert(final.bufferPreserved && final.documentDirty && final.sourceBufferPreserved);
  assert.equal(final.documentVersion, final.initialVersion);
  assert.equal(await readFile(path.join(root, 'workspace/.codocs/a.yaml'), 'utf8'), final.diskText);
  check('YAML text, dirty buffer, disk, and line positions preserved', {
    initialVersion: final.initialVersion, finalVersion: final.documentVersion,
    documentDirty: final.documentDirty, sourceDirty: final.sourceDirty,
    bufferPreserved: final.bufferPreserved, sourceBufferPreserved: final.sourceBufferPreserved,
  });
  result.finalState = final;
  result.passed = true;
} catch(error) {
  result.error = error.stack || String(error);
  console.error(result.error);
  if(socket?.readyState === WebSocket.OPEN) {
    try {
      result.failureDOM = await evaluate("document.body.innerText.slice(-15000)");
      await screenshot('failure');
    } catch {}
  }
} finally {
  await writeFile(path.join(output, 'result.json'), JSON.stringify(result, null, 2));
  await writeFile(path.join(output, 'process.log'), processLog);
  if(socket?.readyState === WebSocket.OPEN) socket.close();
  child.kill('SIGTERM');
  await delay(500);
  console.log(`Result: ${path.join(output, 'result.json')}`);
  if(!result.passed) process.exitCode = 1;
}
